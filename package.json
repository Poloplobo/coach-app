{
  "name": "rugby-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "node --env-file=.env.local scripts/sql-test.mjs supabase/tests/rls_test.sql",
    "accounts": "tsx --env-file=.env.local scripts/create-accounts.ts --dry-run",
    "import": "tsx --env-file=.env.local scripts/import/index.ts --dry-run",
    "test:db:prod": "node --env-file=.env.prod.local scripts/sql-test.mjs supabase/tests/rls_test.sql",
    "accounts:prod": "tsx --env-file=.env.prod.local scripts/create-accounts.ts",
    "import:prod": "tsx --env-file=.env.prod.local scripts/import/index.ts",
    "reset-password": "tsx --env-file=.env.local scripts/reset-password.ts",
    "reset-password:prod": "tsx --env-file=.env.prod.local scripts/reset-password.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
